<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dashboard_icon_list" model="ir.ui.view">
        <field name="name">dashboard.icon.list</field>
        <field name="model">dashboard.icon</field>
        <field name="arch" type="xml">
            <list default_order="category, sequence, key">
                <field name="sequence" widget="handle"/>
                <field name="key"/>
                <field name="label"/>
                <field name="fa_class"/>
                <field name="category"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_dashboard_icon_form" model="ir.ui.view">
        <field name="name">dashboard.icon.form</field>
        <field name="model">dashboard.icon</field>
        <field name="arch" type="xml">
            <form string="Icon">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group string="Identity">
                            <field name="key" readonly="id"
                                   help="Immutable after creation — widget configs reference it verbatim."/>
                            <field name="label"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Rendering">
                            <field name="fa_class" placeholder="fa-clock-o"/>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Archiving hides an icon from new selection while widgets
                        already using it keep rendering. Deleting is blocked while
                        any saved configuration references the key.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dashboard_icons" model="ir.actions.act_window">
        <field name="name">Icon Registry</field>
        <field name="res_model">dashboard.icon</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="menu_dashboard_icons"
              name="Icon Registry"
              parent="menu_dashboard_builder_config"
              action="action_dashboard_icons"
              sequence="45"/>

</odoo>

# Where the Odoo AI gateway lives (internal service DNS in AKS, or
# http://localhost:8069 in dev).
ODOO_BASE_URL=http://localhost:8069
REQUEST_TIMEOUT_SECONDS=60
PORT=8808
LOG_LEVEL=INFO


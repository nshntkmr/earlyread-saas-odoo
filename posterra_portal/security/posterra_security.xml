<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Group: Posterra Portal User (implies portal) -->
    <record id="group_posterra_user" model="res.groups">
        <field name="name">Posterra Portal User</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="comment">Portal users who can access the Posterra dashboard. They can only view their own HHA data.</field>
    </record>

    <!-- Group: Posterra Admin (internal users) -->
    <record id="group_posterra_admin" model="res.groups">
        <field name="name">Posterra Admin</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Internal users who manage HHA provider data, import CSVs, and administer portal users.</field>
    </record>

    <!-- Group: Posterra MSSP User
         For portal users whose data is MSSP / ACO / national-level (no per-HHA restriction).
         Being in this group is the ONLY access requirement — email domain and hha_provider_id
         are irrelevant.  Admin assigns this via Settings → Users → Groups.
         Subdomain: mssp.<base-host>  (completely separate from the HHA portal at posterra.<base-host>)
    -->
    <record id="group_posterra_mssp_user" model="res.groups">
        <field name="name">Posterra MSSP User</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="comment">Portal users who access the MSSP / open-access dashboard at the mssp.* subdomain. No HHA provider restriction applies. Assign this group for ACO builders, MSSP analysts, or any user whose data is not HHA-specific.</field>
    </record>

    <!-- Group: AI Assist Desktop User
         v1 user-scope contract: chatbot SQL is NOT filtered down to a
         portal user's provider scope — it sees the whole tenant (app).
         Therefore only internal analysts explicitly placed in this group
         may use the AI gateway / desktop MCP connectors. Do NOT add
         provider-scoped portal users until per-user predicate scoping
         exists. -->
    <record id="group_ai_assist_user" model="res.groups">
        <field name="name">AI Assist Desktop User</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Internal analysts allowed to query app data through the AI Assist chatbot (desktop MCP). Queries are tenant-scoped to the app but NOT restricted to a user's provider scope — internal users only.</field>
    </record>

    <!-- Record Rule: Portal users can read HHA providers (filtering by email domain is done in controllers) -->
    <record id="rule_hha_provider_portal_own" model="ir.rule">
        <field name="name">HHA Provider: Portal users read access</field>
        <field name="model_id" ref="model_hha_provider"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_posterra_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Record Rule: Admins see all HHA providers -->
    <record id="rule_hha_provider_admin_all" model="ir.rule">
        <field name="name">HHA Provider: Admins see all</field>
        <field name="model_id" ref="model_hha_provider"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_posterra_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Record Rule: Portal users can read scope groups -->
    <record id="rule_hha_scope_group_portal" model="ir.rule">
        <field name="name">HHA Scope Group: Portal users read access</field>
        <field name="model_id" ref="model_hha_scope_group"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_posterra_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Record Rule: Admins full access to scope groups -->
    <record id="rule_hha_scope_group_admin" model="ir.rule">
        <field name="name">HHA Scope Group: Admins full access</field>
        <field name="model_id" ref="model_hha_scope_group"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_posterra_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>

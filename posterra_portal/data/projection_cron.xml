<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Publisher retry: pending/failed projection events → ClickHouse mirror. -->
        <record id="ir_cron_projection_publish" model="ir.cron">
            <field name="name">Projections: publish pending events</field>
            <field name="model_id" model="ir.model" search="[('model','=','dashboard.projection.config')]"/>
            <field name="state">code</field>
            <field name="code">model._cron_publish_pending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <!-- Daily check: cycles whose latest revision is missing from the mirror are re-queued. -->
        <record id="ir_cron_projection_check_mirror" model="ir.cron">
            <field name="name">Projections: check mirror</field>
            <field name="model_id" model="ir.model" search="[('model','=','dashboard.projection.config')]"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_mirror()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
